{
  "folders": [
    {
      "name": "WebQA2026",
      "path": "."
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
    "python.terminal.activateEnvironment": true,
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.cwd": "${workspaceFolder}/backend",
    "python.testing.pytestArgs": [
      "tests"
    ],
    "python.analysis.extraPaths": [
      "./backend",
      "./automation-runner",
      "./worker"
    ],
    "python.envFile": "${workspaceFolder}/.env",
    "typescript.tsdk": "frontend/node_modules/typescript/lib",
    "files.encoding": "utf8",
    "files.eol": "\n",
    "files.exclude": {
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "frontend/.next": true,
      "frontend/public/monaco": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "frontend/.next": true,
      "storage/**": true,
      "03_web_app/**": true
    },
    "editor.formatOnSave": false,
    "[python]": {
      "editor.rulers": [
        140
      ]
    },
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.cwd": "${workspaceFolder}",
    "playwright.reuseBrowser": false,
    "mermaid-preview.theme": "default"
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Backend: FastAPI (dev, SQLite, inline jobs)",
        "type": "debugpy",
        "request": "launch",
        "module": "uvicorn",
        "args": [
          "app.main:app",
          "--host",
          "127.0.0.1",
          "--port",
          "8000",
          "--reload"
        ],
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "TASK_MODE": "inline",
          "DATABASE_URL": "sqlite:///${workspaceFolder}/storage/dev.sqlite3",
          "RUNNER_URL": "",
          "STORAGE_ROOT": "${workspaceFolder}/storage"
        },
        "envFile": "${workspaceFolder}/.env",
        "justMyCode": true
      },
      {
        "name": "Frontend: Next.js dev (http://localhost:3000)",
        "type": "node-terminal",
        "request": "launch",
        "command": "npm run dev",
        "cwd": "${workspaceFolder}/frontend",
        "env": {
          "BACKEND_INTERNAL_URL": "http://127.0.0.1:8000"
        }
      },
      {
        "name": "Worker: Celery (needs Redis)",
        "type": "debugpy",
        "request": "launch",
        "module": "celery",
        "args": [
          "-A",
          "worker.celery_app",
          "worker",
          "--loglevel=INFO",
          "--pool=solo"
        ],
        "cwd": "${workspaceFolder}/worker",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/backend;${workspaceFolder}/worker",
          "TASK_MODE": "celery",
          "STORAGE_ROOT": "${workspaceFolder}/storage"
        },
        "envFile": "${workspaceFolder}/.env"
      },
      {
        "name": "Runner: automation-runner service (:8100)",
        "type": "debugpy",
        "request": "launch",
        "module": "uvicorn",
        "args": [
          "runner.service:app",
          "--host",
          "127.0.0.1",
          "--port",
          "8100"
        ],
        "cwd": "${workspaceFolder}/automation-runner",
        "env": {
          "RUNNER_TOKEN_FILE": "${workspaceFolder}/storage/secrets/runner_token"
        }
      },
      {
        "name": "Runner: Headed exploration (Playwright)",
        "type": "debugpy",
        "request": "launch",
        "module": "runner.explore",
        "args": [
          "--url",
          "${input:exploreUrl}"
        ],
        "cwd": "${workspaceFolder}/automation-runner",
        "console": "integratedTerminal"
      },
      {
        "name": "Backend: pytest current file",
        "type": "debugpy",
        "request": "launch",
        "module": "pytest",
        "args": [
          "${file}",
          "-q"
        ],
        "cwd": "${workspaceFolder}/backend",
        "justMyCode": false
      },
      {
        "name": "Seed database (admin + demo project)",
        "type": "debugpy",
        "request": "launch",
        "module": "app.seed",
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "DATABASE_URL": "sqlite:///${workspaceFolder}/storage/dev.sqlite3",
          "TASK_MODE": "sync",
          "STORAGE_ROOT": "${workspaceFolder}/storage"
        }
      }
    ],
    "compounds": [
      {
        "name": "Full stack (dev): Backend + Frontend",
        "configurations": [
          "Backend: FastAPI (dev, SQLite, inline jobs)",
          "Frontend: Next.js dev (http://localhost:3000)"
        ],
        "stopAll": true
      }
    ],
    "inputs": [
      {
        "id": "exploreUrl",
        "type": "promptString",
        "description": "Base URL (SIT/UAT เท่านั้น)",
        "default": "https://sit.example.test"
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Setup: Python venv + dependencies",
        "type": "shell",
        "command": "python -m venv .venv; .\\.venv\\Scripts\\python -m pip install -r backend\\requirements-dev.txt -r automation-runner\\requirements.txt",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      },
      {
        "label": "Setup: Frontend npm install",
        "type": "shell",
        "command": "npm install",
        "options": {
          "cwd": "${workspaceFolder}/frontend"
        },
        "problemMatcher": []
      },
      {
        "label": "DB: migrate (alembic upgrade head)",
        "type": "shell",
        "command": "..\\.venv\\Scripts\\python -m alembic upgrade head",
        "options": {
          "cwd": "${workspaceFolder}/backend",
          "env": {
            "DATABASE_URL": "sqlite:///${workspaceFolder}/storage/dev.sqlite3"
          }
        },
        "problemMatcher": []
      },
      {
        "label": "DB: seed admin + demo",
        "type": "shell",
        "command": "..\\.venv\\Scripts\\python -m app.seed",
        "options": {
          "cwd": "${workspaceFolder}/backend",
          "env": {
            "DATABASE_URL": "sqlite:///${workspaceFolder}/storage/dev.sqlite3",
            "TASK_MODE": "sync"
          }
        },
        "dependsOn": "DB: migrate (alembic upgrade head)",
        "problemMatcher": []
      },
      {
        "label": "Test: backend (pytest)",
        "type": "shell",
        "command": "..\\.venv\\Scripts\\python -m pytest -q",
        "options": {
          "cwd": "${workspaceFolder}/backend"
        },
        "group": "test",
        "problemMatcher": []
      },
      {
        "label": "Test: automation-runner",
        "type": "shell",
        "command": "..\\.venv\\Scripts\\python -m pytest -q",
        "options": {
          "cwd": "${workspaceFolder}/automation-runner"
        },
        "group": "test",
        "problemMatcher": []
      },
      {
        "label": "Test: frontend (typecheck + vitest)",
        "type": "shell",
        "command": "npm run typecheck; npm test",
        "options": {
          "cwd": "${workspaceFolder}/frontend"
        },
        "group": "test",
        "problemMatcher": [
          "$tsc"
        ]
      },
      {
        "label": "Test: E2E (Playwright)",
        "type": "shell",
        "command": "npx next build; npx playwright install chromium; $env:PYTHON='..\\.venv\\Scripts\\python.exe'; npx playwright test",
        "options": {
          "cwd": "${workspaceFolder}/frontend"
        },
        "group": "test",
        "problemMatcher": []
      },
      {
        "label": "Docker: compose up -d",
        "type": "shell",
        "command": "docker compose up -d --build",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      },
      {
        "label": "Docker: compose logs -f",
        "type": "shell",
        "command": "docker compose logs -f",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "isBackground": true,
        "problemMatcher": []
      },
      {
        "label": "Docker: compose restart",
        "type": "shell",
        "command": "docker compose restart",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      },
      {
        "label": "Docker: compose down",
        "type": "shell",
        "command": "docker compose down",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      },
      {
        "label": "Open app in browser",
        "type": "shell",
        "command": "Start-Process http://localhost:3000",
        "problemMatcher": []
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-python.debugpy",
      "charliermarsh.ruff",
      "dbaeumer.vscode-eslint",
      "bradlc.vscode-tailwindcss",
      "ms-playwright.playwright",
      "vitest.explorer",
      "ms-azuretools.vscode-docker",
      "mtxr.sqltools",
      "mtxr.sqltools-driver-pg",
      "bierner.markdown-mermaid",
      "github.vscode-github-actions",
      "redhat.vscode-yaml",
      "humao.rest-client"
    ]
  }
}