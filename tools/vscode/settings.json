{
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}/backend",
  "python.testing.pytestArgs": ["tests"],
  "python.analysis.extraPaths": ["./backend", "./automation-runner", "./worker"],
  "python.envFile": "${workspaceFolder}/.env",
  "typescript.tsdk": "frontend/node_modules/typescript/lib",
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.exclude": { "**/__pycache__": true, "**/.pytest_cache": true, "frontend/.next": true, "frontend/public/monaco": true },
  "search.exclude": { "**/node_modules": true, "frontend/.next": true, "storage/**": true, "03_web_app/**": true },
  "editor.formatOnSave": false,
  "[python]": { "editor.rulers": [140] },
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.cwd": "${workspaceFolder}",
  "playwright.reuseBrowser": false,
  "mermaid-preview.theme": "default"
}
