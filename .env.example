# ================================================================
# BRS to QA Automation Platform — copy to .env and edit
#   copy .env.example .env        (PowerShell / CMD)
# Never commit .env (it is in .gitignore)
# ================================================================

# --- Network / ports ---------------------------------------------
# 127.0.0.1 = only this computer (default, recommended)
# 0.0.0.0   = everyone on the LAN can open the site — ALSO set ALLOW_NETWORK_SHARING=true (read SECURITY.md first)
BIND_HOST=127.0.0.1
ALLOW_NETWORK_SHARING=false
APP_PORT=3000
BACKEND_PORT=8000

# --- AI (Claude API) — server side only, never sent to the browser
# Leave empty to use the offline Rule Engine. Model name: see https://docs.claude.com/en/docs/about-claude/models
CLAUDE_API_KEY=
CLAUDE_MODEL=
AI_MODE=rule
VISION_ENABLED=false

# --- Secrets (leave empty = generated automatically into .\storage\secrets\) ---
SECRET_KEY=
RUNNER_TOKEN=

# --- Database (PostgreSQL in Docker) --------------------------------
POSTGRES_USER=brsqa
POSTGRES_PASSWORD=brsqa_local_only
POSTGRES_DB=brsqa

# --- Session / upload ---------------------------------------------
SESSION_MINUTES=30
MAX_UPLOAD_MB=50

# --- Seed admin (forced password change at first login) -------------
SEED_ADMIN_PASSWORD=Admin@12345

# --- Test Runner limits --------------------------------------------
RUNNER_TIMEOUT_SEC=120
RUNNER_MAX_MEMORY_MB=1024
RUNNER_MAX_OUTPUT_KB=512

# --- Environments for generated tests / JMeter (production is blocked) ---
ENV_ALLOWLIST=https://sit.example.test,https://uat.example.test

# --- GitHub (Fine-grained PAT or GitHub App installation token; backend only) ---
GITHUB_TOKEN=

# --- Development Mode without Docker (see DEVELOPMENT.md) -----------
# DATABASE_URL=sqlite:///./storage/dev.sqlite3
# TASK_MODE=inline
# RUNNER_URL=
